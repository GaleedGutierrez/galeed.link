{
	"name": "galeed.link",
	"private": true,
	"type": "module",
	"version": "0.0.1",
	"keywords": [
		"Astro",
		"TypeScript",
		"CSS"
	],
	"bugs": {
		"url": "https://github.com/GaleedGutierrez/galeed.link/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/GaleedGutierrez/galeed.link.git"
	},
	"engines": {
		"node": ">=22.23.4",
		"npm": ">=10.0.0"
	},
	"homepage": "https://github.com/GaleedGutierrez/galeed.link#readme",
	"license": "MIT",
	"author": "Galeed Gutierrez <galeedeveloper@gmail.com> (https://galeedgutierrez.com/)",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build && npm run purge-css && npm run lightningcss && npm run subset-fonts",
		"preview": "astro preview",
		"astro": "astro",
		"purge-css": "tsx ./scripts/purgeCss.ts",
		"lightningcss": "tsx ./scripts/lightningcss.ts",
		"subset-fonts": "tsx ./scripts/subsetFonts.ts",
		"lint": "eslint ./ --max-warnings 0",
		"lint:fix": "eslint --fix ./**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,astro}",
		"prettier": "prettier ./ --check",
		"prettier:fix": "prettier ./ --write",
		"stylelint": "stylelint ./**/*.{css,scss} --allow-empty-input",
		"stylelint:fix": "stylelint --fix ./**/*.{css,scss} --allow-empty-input",
		"lint-text": "textlint ./**/*.md ",
		"lint-text:fix": "textlint --fix ./**/*.md ",
		"lint-md": "markdownlint-cli2 --config \".markdownlint-cli2.jsonc\" **/*.md \"#node_modules\" && npm run lint-text",
		"lint-md:fix": "markdownlint-cli2 --config \".markdownlint-cli2.jsonc\" --fix **/*.md \"#node_modules\" && npm run lint-text:fix",
		"check-for-dupes": "jscpd ./",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:performance": "lighthouse http://localhost:4173/ --view --output html --output-path ./lighthouse-report/lighthouse-report.html",
		"prepare": "husky"
	},
	"dependencies": {
		"@astrojs/partytown": "^2.1.9",
		"@astrojs/sitemap": "^3.7.6",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/barlow": "^5.3.0",
		"@galeedgutierrez/shared-assets": "^0.2.4",
		"astro": "^7.4.13",
		"astro-icon": "^1.2.0",
		"astro-seo": "^1.2.0",
		"astro-seo-schema": "^7.0.2",
		"schema-dts": "^2.1.0",
		"web-vitals": "^6.2.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@capsizecss/core": "^4.1.3",
		"@capsizecss/metrics": "^4.5.0",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@eslint/js": "^10.0.1",
		"@iconify-json/lucide": "^1.2.58",
		"@iconify-json/simple-icons": "^1.2.103",
		"@stylistic/eslint-plugin": "^6.0.1",
		"@typescript-eslint/parser": "^8.38.0",
		"@unocss/astro": "^66.3.3",
		"@unocss/reset": "^66.3.3",
		"@vitest/eslint-plugin": "^1.3.4",
		"cssnano": "^8.0.10",
		"cssnano-preset-advanced": "^8.0.10",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-astro": "^3.2.1",
		"eslint-plugin-check-file": "^3.3.0",
		"eslint-plugin-import-x": "^4.16.1",
		"eslint-plugin-jsdoc": "^65.5.3",
		"eslint-plugin-jsonc": "^3.4.2",
		"eslint-plugin-jsx-a11y-x": "^0.2.0",
		"eslint-plugin-playwright": "^2.2.0",
		"eslint-plugin-prettier": "^5.5.3",
		"eslint-plugin-security": "^4.2.1",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-sort-class-members": "^1.21.0",
		"eslint-plugin-tsdoc": "^0.5.4",
		"eslint-plugin-unicorn": "^80.0.0",
		"eslint-plugin-unused-imports": "^4.1.4",
		"husky": "^9.1.7",
		"jscpd": "^5.4.3",
		"lightningcss": "^1.30.1",
		"markdownlint-cli2": "^0.24.2",
		"postcss": "^8.5.6",
		"postcss-custom-properties": "^15.0.5",
		"postcss-load-config": "^6.0.1",
		"postcss-mixins": "^12.1.2",
		"postcss-utopia": "^1.1.0",
		"prettier": "3.10.1",
		"prettier-plugin-astro": "1.1.2",
		"prettier-plugin-tailwindcss": "0.8.1",
		"purgecss": "^9.1.0",
		"sonda": "^0.14.0",
		"stylelint": "^17.16.0",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-order": "^8.1.3",
		"stylelint-prettier": "^5.0.3",
		"subset-font": "^2.9.0",
		"textlint": "^16.1.3",
		"textlint-filter-rule-comments": "^1.2.2",
		"textlint-rule-terminology": "^5.2.14",
		"tsx": "^4.20.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.38.0",
		"unocss": "^66.3.3",
		"vitest": "^5.1.1"
	},
	"lint-staged": {
		"*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,astro}": "eslint --fix",
		"*{css,s(a|c)ss}": "stylelint --fix",
		"*.{md,mdx}": [
			"markdownlint-cli2 --config \".markdownlint-cli2.jsonc\" --fix",
			"textlint --fix",
			"prettier --write"
		],
		"*.{json,jsonc}": [
			"prettier --write"
		]
	},
	"jscpd": {
		"threshold": 5,
		"reporters": [
			"silent"
		],
		"ignore": [
			"**/.agents/**",
			"**/.claude/**",
			"**/.astro/**",
			"**/node_modules/**",
			"**/dist/**",
			"**/dist-dev/**",
			"**/build/**",
			"**/fonts/**",
			"**/coverage/**",
			"**/playwright-reports/**",
			"**/test-results/**",
			"**/lighthouse-report/**",
			"**/tsconfig.*.json",
			"**/components/ui/**",
			"**/*.svg",
			"**/*.md",
			"**/package-lock.json"
		],
		"absolute": true
	}
}
