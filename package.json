{
	"name": "galeed.link",
	"private": true,
	"type": "module",
	"version": "0.0.1",
	"keywords": [
		"Astro",
		"TypeScript",
		"CSS"
	],
	"bugs": {
		"url": "https://github.com/GaleedGutierrez/galeed.link/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/GaleedGutierrez/galeed.link.git"
	},
	"engines": {
		"node": ">=26.13.1",
		"npm": ">=12.2.3"
	},
	"browserslist": [
		"baseline widely available with downstream"
	],
	"homepage": "https://github.com/GaleedGutierrez/galeed.link#readme",
	"license": "MIT",
	"author": "Galeed Gutierrez <galeedeveloper@gmail.com> (https://galeedgutierrez.com/)",
	"scripts": {
		"dev": "astro dev",
		"build": "galeed-git-history && astro build",
		"preview": "astro preview --port 4173",
		"astro": "astro",
		"lint": "eslint ./ --max-warnings 0",
		"lint:fix": "eslint --fix .",
		"prettier": "prettier ./ --check",
		"prettier:fix": "prettier ./ --write",
		"stylelint": "stylelint \"**/*.css\"",
		"stylelint:fix": "stylelint --fix \"**/*.css\"",
		"lint-text": "textlint \"**/*.md\"",
		"lint-text:fix": "textlint --fix \"**/*.md\"",
		"lint-md": "markdownlint-cli2 && npm run lint-text",
		"lint-md:fix": "markdownlint-cli2 --fix && npm run lint-text:fix",
		"check-for-dupes": "jscpd ./",
		"lint:all": "npm run lint && npm run stylelint && npm run prettier && npm run lint-md && npm run check-for-dupes",
		"typecheck": "astro check",
		"verify": "npm run lint:all && npm run typecheck && npm run test",
		"commit": "commit",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:performance": "lighthouse http://localhost:4173/ --view --output html --output-path ./lighthouse-report/lighthouse-report.html --blocked-url-patterns=\"*kaspersky-labs.com*\" --blocked-url-patterns=\"*googletagmanager.com*\" --blocked-url-patterns=\"*google-analytics.com*\"",
		"prepare": "husky"
	},
	"dependencies": {
		"@astrojs/partytown": "^2.1.9",
		"@astrojs/sitemap": "^3.7.6",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/barlow": "^5.3.0",
		"@galeedgutierrez/shared-assets": "^0.6.2",
		"astro": "^7.4.13",
		"astro-icon": "^1.2.0",
		"astro-seo": "^1.2.0",
		"astro-seo-schema": "^7.0.2",
		"schema-dts": "^1.1.5",
		"web-vitals": "^6.2.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@axe-core/playwright": "^4.14.0",
		"@capsizecss/core": "^4.1.3",
		"@capsizecss/metrics": "^4.5.0",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/prompt-cli": "^21.2.4",
		"@galeedgutierrez/eslint-config": "^0.1.0",
		"@galeedgutierrez/frontend-config": "^0.1.0",
		"@galeedgutierrez/tsconfig": "^0.1.0",
		"@iconify-json/lucide": "^1.2.58",
		"@iconify-json/simple-icons": "^1.2.103",
		"@lhci/cli": "^0.16.1",
		"@playwright/test": "^1.65.1",
		"@unocss/astro": "^66.3.3",
		"@unocss/reset": "^66.3.3",
		"eslint": "^10.15.0",
		"husky": "^9.1.7",
		"jscpd": "^5.4.3",
		"lighthouse": "^13.6.0",
		"lightningcss": "^1.30.1",
		"markdownlint-cli2": "^0.24.2",
		"prettier": "3.10.1",
		"sonda": "^0.14.0",
		"stylelint": "^18.0.0",
		"textlint": "^16.1.3",
		"typescript": "^6.0.3",
		"unocss": "^66.3.3",
		"vitest": "^5.1.1",
		"yaml": "^2.9.1"
	},
	"jscpd": {
		"threshold": 5,
		"reporters": [
			"silent"
		],
		"ignore": [
			"**/.agents/**",
			"**/.claude/**",
			"**/.astro/**",
			"**/node_modules/**",
			"**/dist/**",
			"**/dist-dev/**",
			"**/build/**",
			"**/coverage/**",
			"**/playwright-report/**",
			"**/test-results/**",
			"**/lighthouse-report/**",
			"**/.lighthouseci/**",
			"**/tsconfig.*.json",
			"**/components/ui/**",
			"**/*.svg",
			"**/*.md",
			"**/package-lock.json"
		],
		"absolute": true
	},
	"prettier": "@galeedgutierrez/frontend-config/prettier"
}
