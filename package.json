{
	"name": "galeed.link",
	"private": true,
	"type": "module",
	"version": "0.0.1",
	"keywords": [
		"Astro",
		"TypeScript",
		"CSS"
	],
	"bugs": {
		"url": "https://github.com/GaleedGutierrez/galeed.link/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/GaleedGutierrez/galeed.link.git"
	},
	"engines": {
		"node": ">=26.13.1",
		"npm": ">=12.2.3"
	},
	"browserslist": [
		"baseline widely available with downstream"
	],
	"homepage": "https://github.com/GaleedGutierrez/galeed.link#readme",
	"license": "MIT",
	"author": "Galeed Gutierrez <galeedeveloper@gmail.com> (https://galeedgutierrez.com/)",
	"scripts": {
		"dev": "astro dev",
		"build": "npm run git-history && astro build && npm run purge-css && npm run lightningcss && npm run prune-css-vars && npm run subset-fonts && npm run inline-css && npm run csp-headers",
		"preview": "astro preview --port 4173",
		"astro": "astro",
		"purge-css": "node ./scripts/purgeCss.ts",
		"lightningcss": "node ./scripts/lightningcss.ts",
		"prune-css-vars": "node ./scripts/pruneCssVars.ts",
		"subset-fonts": "node ./scripts/subsetFonts.ts",
		"inline-css": "node ./scripts/inlineCss.ts",
		"csp-headers": "node ./scripts/cspHeaders.ts",
		"git-history": "node ./scripts/gitHistory.ts",
		"lint": "eslint ./ --max-warnings 0",
		"lint:fix": "eslint --fix ./**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,yml,yaml,astro}",
		"prettier": "prettier ./ --check",
		"prettier:fix": "prettier ./ --write",
		"stylelint": "stylelint ./**/*.{css,scss} --allow-empty-input",
		"stylelint:fix": "stylelint --fix ./**/*.{css,scss} --allow-empty-input",
		"lint-text": "textlint \"**/*.md\"",
		"lint-text:fix": "textlint --fix \"**/*.md\"",
		"lint-md": "markdownlint-cli2 && npm run lint-text",
		"lint-md:fix": "markdownlint-cli2 --fix && npm run lint-text:fix",
		"check-for-dupes": "jscpd ./",
		"lint:all": "npm run lint && npm run stylelint && npm run prettier && npm run lint-md && npm run check-for-dupes",
		"typecheck": "astro check",
		"verify": "npm run lint:all && npm run typecheck && npm run test",
		"commit": "commit",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:performance": "lighthouse http://localhost:4173/ --view --output html --output-path ./lighthouse-report/lighthouse-report.html --blocked-url-patterns=\"*kaspersky-labs.com*\" --blocked-url-patterns=\"*googletagmanager.com*\" --blocked-url-patterns=\"*google-analytics.com*\"",
		"prepare": "husky"
	},
	"dependencies": {
		"@astrojs/partytown": "^2.1.9",
		"@astrojs/sitemap": "^3.7.6",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource/barlow": "^5.3.0",
		"@galeedgutierrez/shared-assets": "^0.6.2",
		"astro": "^7.4.13",
		"astro-icon": "^1.2.0",
		"astro-seo": "^1.2.0",
		"astro-seo-schema": "^7.0.2",
		"schema-dts": "^1.1.5",
		"web-vitals": "^6.2.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@axe-core/playwright": "^4.14.0",
		"@capsizecss/core": "^4.1.3",
		"@capsizecss/metrics": "^4.5.0",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@commitlint/prompt-cli": "^21.2.4",
		"@eslint/js": "^10.0.1",
		"@iconify-json/lucide": "^1.2.58",
		"@iconify-json/simple-icons": "^1.2.103",
		"@lhci/cli": "^0.16.1",
		"@playwright/test": "^1.65.1",
		"@stylistic/eslint-plugin": "^6.0.1",
		"@typescript-eslint/parser": "^8.38.0",
		"@unocss/astro": "^66.3.3",
		"@unocss/reset": "^66.3.3",
		"@vitest/eslint-plugin": "^1.3.4",
		"browserslist": "^4.29.6",
		"cssnano": "^9.9.0",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-astro": "^3.2.1",
		"eslint-plugin-check-file": "^3.3.0",
		"eslint-plugin-import-x": "^4.16.1",
		"eslint-plugin-jsdoc": "^65.5.3",
		"eslint-plugin-jsonc": "^3.4.2",
		"eslint-plugin-jsx-a11y-x": "^0.2.0",
		"eslint-plugin-playwright": "^2.2.0",
		"eslint-plugin-prettier": "^5.5.3",
		"eslint-plugin-security": "^4.2.1",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-sort-class-members": "^1.21.0",
		"eslint-plugin-tsdoc": "^0.5.4",
		"eslint-plugin-unicorn": "^80.0.0",
		"eslint-plugin-unused-imports": "^4.1.4",
		"eslint-plugin-yml": "^3.10.0",
		"husky": "^9.1.7",
		"jscpd": "^5.4.3",
		"lighthouse": "^13.6.0",
		"lightningcss": "^1.30.1",
		"markdownlint-cli2": "^0.24.2",
		"postcss": "^8.5.6",
		"postcss-custom-properties": "^15.0.5",
		"postcss-load-config": "^6.0.1",
		"postcss-mixins": "^12.1.2",
		"postcss-utopia": "^1.1.0",
		"prettier": "3.10.1",
		"prettier-plugin-astro": "1.1.2",
		"prettier-plugin-tailwindcss": "0.8.1",
		"purgecss": "^9.1.0",
		"sonda": "^0.14.0",
		"stylelint": "^18.0.0",
		"stylelint-config-standard": "^41.0.0",
		"stylelint-order": "^8.1.3",
		"stylelint-prettier": "^5.0.3",
		"subset-font": "^2.9.0",
		"textlint": "^16.1.3",
		"textlint-filter-rule-comments": "^1.2.2",
		"textlint-rule-terminology": "^5.2.14",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.38.0",
		"unocss": "^66.3.3",
		"vitest": "^5.1.1",
		"yaml": "^2.9.1"
	},
	"lint-staged": {
		"*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,yml,yaml,astro}": "eslint --fix",
		"*{css,s(a|c)ss}": "stylelint --fix",
		"*.{md,mdx}": [
			"markdownlint-cli2 --no-globs --fix",
			"textlint --fix",
			"prettier --write"
		],
		"*.{json,jsonc,yml,yaml}": [
			"prettier --write"
		]
	},
	"jscpd": {
		"threshold": 5,
		"reporters": [
			"silent"
		],
		"ignore": [
			"**/.agents/**",
			"**/.claude/**",
			"**/.astro/**",
			"**/node_modules/**",
			"**/dist/**",
			"**/dist-dev/**",
			"**/build/**",
			"**/coverage/**",
			"**/playwright-report/**",
			"**/test-results/**",
			"**/lighthouse-report/**",
			"**/.lighthouseci/**",
			"**/tsconfig.*.json",
			"**/components/ui/**",
			"**/*.svg",
			"**/*.md",
			"**/package-lock.json"
		],
		"absolute": true
	}
}
