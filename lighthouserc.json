{
	"ci": {
		"collect": {
			"staticDistDir": "./dist",
			"url": ["http://localhost/", "http://localhost/404.html"],
			"numberOfRuns": 3,
			"settings": {
				"blockedUrlPatterns": [
					"*kaspersky-labs.com*",
					"*googletagmanager.com*",
					"*google-analytics.com*"
				]
			}
		},
		"assert": {
			"assertMatrix": [
				{
					"matchingUrlPattern": ".*",
					"preset": "lighthouse:no-pwa",
					"aggregationMethod": "median",
					"assertions": {
						"categories:performance": [
							"error",
							{ "minScore": 0.9 }
						],
						"categories:accessibility": [
							"error",
							{ "minScore": 1 }
						],
						"categories:best-practices": [
							"error",
							{ "minScore": 1 }
						],
						"largest-contentful-paint": [
							"error",
							{ "maxNumericValue": 2500 }
						],
						"cumulative-layout-shift": [
							"error",
							{ "maxNumericValue": 0.1 }
						],
						"total-blocking-time": [
							"error",
							{ "maxNumericValue": 200 }
						],
						"total-byte-weight": [
							"error",
							{ "maxNumericValue": 500000 }
						],
						"is-crawlable": "off"
					}
				},
				{
					"matchingUrlPattern": "/$",
					"aggregationMethod": "median",
					"assertions": {
						"is-crawlable": ["error", { "minScore": 1 }],
						"categories:seo": ["error", { "minScore": 1 }]
					}
				}
			]
		},
		"upload": {
			"target": "filesystem",
			"outputDir": "./lighthouse-report"
		}
	}
}
