{
	"ci": {
		"collect": {
			"staticDistDir": "./dist",
			"url": ["http://localhost/", "http://localhost/404.html"],
			"numberOfRuns": 3,
			"settings": {
				"blockedUrlPatterns": [
					"*kaspersky-labs.com*",
					"*googletagmanager.com*",
					"*google-analytics.com*"
				]
			}
		},
		"assert": {
			"assertMatrix": [
				{
					"matchingUrlPattern": "/$",
					"assertions": {
						"categories:performance": [
							"error",
							{ "minScore": 0.9 }
						],
						"categories:accessibility": [
							"error",
							{ "minScore": 1 }
						],
						"categories:best-practices": [
							"error",
							{ "minScore": 1 }
						],
						"categories:seo": ["error", { "minScore": 1 }]
					}
				},
				{
					"matchingUrlPattern": "/404.html$",
					"assertions": {
						"categories:performance": [
							"error",
							{ "minScore": 0.9 }
						],
						"categories:accessibility": [
							"error",
							{ "minScore": 1 }
						],
						"categories:best-practices": [
							"error",
							{ "minScore": 1 }
						]
					}
				}
			]
		},
		"upload": {
			"target": "filesystem",
			"outputDir": "./lighthouse-report"
		}
	}
}
