---
import styles from "./styles.module.css";

export interface NavSection {
	id: string;
	label: string;
}

interface Props {
	sections: NavSection[];
}

const { sections } = Astro.props;
---

<nav
	aria-label="Secciones"
	class:list={["sticky top-0 mt-6", styles["navbar"]]}
>
	<ul
		class:list={[
			"flex gap-x-1 overflow-x-auto py-1",
			styles["navbar__list"],
		]}
		data-nav-list
		role="list"
	>
		{sections.map((section) => (
			<li>
				<a
					class:list={[
						"relative inline-flex min-h-11 shrink-0 items-center whitespace-nowrap px-3",
						styles["navbar__link"],
					]}
					data-nav-link
					href={`#${section.id}`}
				>
					{section.label}
				</a>
			</li>
		))}
	</ul>
</nav>
<script>
	// Mark the section in view as current (§7.5) and keep its link visible in
	// the horizontally scrolling list.
	const list = document.querySelector<HTMLElement>("[data-nav-list]");
	const links = [
		...document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"),
	];
	const prefersReducedMotion = globalThis.matchMedia(
		"(prefers-reduced-motion: reduce)",
	);

	// Scrolls the list only, never the page.
	const revealInList = (link: HTMLAnchorElement): void => {
		if (!list) {
			return;
		}

		const start = link.offsetLeft - list.offsetLeft;
		const end = start + link.offsetWidth;
		const isVisible =
			start >= list.scrollLeft &&
			end <= list.scrollLeft + list.clientWidth;

		if (isVisible) {
			return;
		}

		list.scrollTo({
			left: start - (list.clientWidth - link.offsetWidth) / 2,
			behavior: prefersReducedMotion.matches ? "auto" : "smooth",
		});
	};

	// Current section = the last one whose heading has reached the line where
	// an anchor jump lands it (its scroll-margin-top, plus some slack).
	// Computed from positions on scroll, not with an IntersectionObserver
	// band: anchor jumps skip over a band without ever intersecting it.
	// At the bottom of the page the last link wins, since the last sections
	// are too short for their headings to reach the line. A clicked link
	// stays current until the user scrolls on their own.
	const LINE_SLACK = 24;
	const targets = links.flatMap((link) => {
		const heading = document.querySelector<HTMLElement>(link.hash);

		return heading ? [{ heading, link }] : [];
	});
	const lastLink = links.at(-1);
	let currentLink: HTMLAnchorElement | undefined;
	let pinnedLink: HTMLAnchorElement | undefined;

	const activationLine = (heading: HTMLElement): number =>
		Number.parseFloat(getComputedStyle(heading).scrollMarginTop) +
		LINE_SLACK;

	const isAtPageBottom = (): boolean =>
		globalThis.innerHeight + globalThis.scrollY >=
		document.documentElement.scrollHeight - 2;

	const setCurrent = (next: HTMLAnchorElement | undefined): void => {
		if (next === currentLink) {
			return;
		}

		currentLink?.removeAttribute("aria-current");
		next?.setAttribute("aria-current", "true");
		currentLink = next;

		if (next) {
			revealInList(next);
		}
	};

	const update = (): void => {
		if (pinnedLink) {
			setCurrent(pinnedLink);

			return;
		}

		if (isAtPageBottom()) {
			setCurrent(lastLink);

			return;
		}

		const passed = targets.filter(
			({ heading }) =>
				heading.getBoundingClientRect().top <= activationLine(heading),
		);

		setCurrent(passed.at(-1)?.link);
	};

	let isUpdateQueued = false;

	globalThis.addEventListener(
		"scroll",
		() => {
			if (isUpdateQueued) {
				return;
			}

			isUpdateQueued = true;
			requestAnimationFrame(() => {
				isUpdateQueued = false;
				update();
			});
		},
		{ passive: true },
	);
	globalThis.addEventListener("resize", update, { passive: true });

	for (const link of links) {
		link.addEventListener("click", () => {
			pinnedLink = link;
			setCurrent(link);
		});
	}

	// User-driven scrolling releases the pin. pointerdown fires before a
	// nav link's click, which then pins that link again.
	for (const type of ["wheel", "touchmove", "keydown", "pointerdown"]) {
		globalThis.addEventListener(
			type,
			() => {
				pinnedLink = undefined;
			},
			{ passive: true },
		);
	}

	update();
</script>
