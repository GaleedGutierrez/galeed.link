---
import { PROFILE, SOCIAL_LINKS } from '@/data/hub';

import styles from './styles.module.css';

const linkedin = SOCIAL_LINKS.find((link) => link.label === 'LinkedIn');
---

<p class={styles['contact__lead']}>
	¿Tenés un proyecto en mente o una propuesta? Escribime y lo charlamos.
</p>
<div class="flex flex-wrap gap-3">
	<!-- Cloudflare's email obfuscation hid this link from crawlers that don't
	 run JS. The address is already public in /llms.txt, so hiding it here
	 kept no spam away. -->
	<!--email_off-->
	<a
		class="a-button a-button--primary a-button--wipe"
		href={`mailto:${PROFILE.email}`}
	>
		Escribime
		{/* The visible label stays first (SC 2.5.3); the suffix says where
		 the link goes (SC 2.4.9). */}
		<span class="sr-only">por email</span>
	</a>
	<!--/email_off-->
	{linkedin && (
		<a
			class="a-button a-button--secondary"
			href={linkedin.href}
			rel="me noopener"
			target="_blank"
		>
			LinkedIn
			<span class="sr-only">(se abre en una pestaña nueva)</span>
		</a>
	)}
</div>
