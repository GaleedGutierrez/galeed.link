---
import { Icon } from "astro-icon/components";

import styles from "./styles.module.css";
---

<div class="flex flex-col items-start gap-4 px-4 py-12">
	<p class={styles["not-found__code"]}>Error 404</p>
	<h1>Esta página no existe</h1>
	<p class={styles["not-found__text"]}>
		El enlace puede estar roto o la página se movió.
	</p>
	<a
		class="a-button a-button--primary mt-2"
		href="/"
	>
		<Icon
			aria-hidden="true"
			name="lucide:arrow-left"
		/>
		Volver al inicio
	</a>
</div>
