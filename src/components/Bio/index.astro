---
import Chip from "@components/Chip/index.astro";
import { Icon } from "astro-icon/components";

import { getStudies, PROFILE } from "@/data/hub";
import { personalSchema } from "@/data/personalSchema";

import styles from "./styles.module.css";

const ABOUT = [
	{ icon: "lucide:map-pin", label: "Argentino" },
	{ icon: "lucide:cpu", label: "Tecnología" },
	{ icon: "lucide:dumbbell", label: "Gym" },
	{ icon: "lucide:mountain", label: "Hiking" },
	{ icon: "lucide:dices", label: "Juegos de mesa" },
	{ icon: "lucide:leaf", label: "Mate" },
	{ icon: "lucide:coffee", label: "Café" },
];

// The studies in progress, the ones the JSON-LD lists as `affiliation`,
// oldest first.
const studies = new Intl.ListFormat("es").format(
	getStudies()
		.filter(({ isInProgress }) => isInProgress)
		.toSorted((a, b) => a.startDate.getTime() - b.startDate.getTime())
		.map(
			({ program, institution }) =>
				`${program} en la ${institution.name}`,
		),
);

const STACK = [
	{ icon: "simple-icons:react", label: "React" },
	{ icon: "simple-icons:astro", label: "Astro" },
	{ icon: "simple-icons:typescript", label: "TypeScript" },
	{ icon: "simple-icons:tailwindcss", label: "Tailwind CSS" },
	{ icon: "simple-icons:nodedotjs", label: "Node.js" },
];
---

<p class={styles["bio__lead"]}>
	Soy {personalSchema.name}, desarrollador frontend en Jujuy, Argentina.
	Construyo interfaces accesibles y rápidas con React, Astro y TypeScript, y
	las pruebo con Vitest y Playwright. Estudio {studies}, y hago cursos de
	Platzi.
	{PROFILE.isAvailable && " Estoy disponible para proyectos freelance."}
</p>
<div class="mt-6 grid grid-cols-[1fr_1px_1fr] gap-4">
	<section class="flex flex-col gap-3">
		<h3 class={styles["bio__heading"]}>Sobre mí</h3>
		<ul
			class="flex flex-col gap-2"
			role="list"
		>
			{ABOUT.map((item) => (
				<li
					class:list={[
						"inline-flex items-start gap-2",
						styles["bio__item"],
					]}
				>
					<Icon
						aria-hidden="true"
						class={styles["bio__icon"]}
						name={item.icon}
						size={18}
					/>
					{item.label}
				</li>
			))}
		</ul>
	</section>
	<div
		aria-hidden="true"
		class={styles["bio__rule"]}
	></div>
	<section class="flex flex-col gap-3">
		<h3 class={styles["bio__heading"]}>Stack tech</h3>
		<ul
			class="flex flex-wrap gap-2"
			role="list"
		>
			{STACK.map((item) => (
				<li>
					<Chip
						icon={item.icon}
						label={item.label}
					/>
				</li>
			))}
		</ul>
	</section>
</div>
