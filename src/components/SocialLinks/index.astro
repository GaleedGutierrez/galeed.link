---
import { Icon } from "astro-icon/components";

import { SOCIAL_LINKS } from "@/data/hub";

import styles from "./styles.module.css";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<ul
	class:list={["grid grid-cols-4 gap-2 px-4", className]}
	role="list"
>
	{SOCIAL_LINKS.map((link) => (
		<li>
			<a
				class:list={[
					"flex min-h-14 flex-col items-center justify-center gap-1",
					styles["social-links__link"],
				]}
				href={link.href}
				rel="me noopener"
				target="_blank"
			>
				<Icon
					aria-hidden="true"
					name={link.icon}
					size={20}
				/>
				<span>
					{link.label}
					{link.srSuffix && (
						<span class="sr-only">{link.srSuffix}</span>
					)}
				</span>
				<span class="sr-only">(se abre en una pestaña nueva)</span>
			</a>
		</li>
	))}
</ul>
