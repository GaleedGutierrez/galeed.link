---
import Chip from "@components/Chip/index.astro";
import { Picture } from "astro:assets";

import type { TileItem } from "@/types/designTokens";

import styles from "./styles.module.css";

interface Props {
	item: TileItem;
}

const { item } = Astro.props;
// The column caps the cards before the 40em breakpoint, so the mobile
// values are capped too: without min(), a 480–639px viewport asked for
// a wider file than the card ever shows.
const sizes = item.featured
	? "(min-width: 40em) 448px, min(calc(100vw - 32px), 448px)"
	: "(min-width: 40em) 218px, min(calc(50vw - 22px), 218px)";
// Private work has no URL: the tile is a static <article>, with no hover.
const Tag = item.href ? "a" : "article";
const linkProps = item.href
	? { href: item.href, rel: "noopener", target: "_blank" }
	: {};
const hasChips = Boolean(item.status ?? item.chips?.length);
---

<Tag
	class:list={["flex flex-col gap-2", styles["tile-card"]]}
	{...linkProps}
>
	<figure
		class:list={[
			// 16:9 for every tile: the shared-assets screenshots are 16:10, so
			// object-top crops only their bottom strip. A square crop zoomed them in.
			"relative aspect-video overflow-hidden",
			styles["tile-card__media"],
		]}
	>
		{item.image ? (
			<Picture
				alt={item.alt}
				class="h-full w-full object-cover object-top"
				formats={["avif", "webp"]}
				loading="lazy"
				pictureAttributes={{ class: "block h-full" }}
				sizes={sizes}
				src={item.image}
				// The fallback <img> would otherwise be the full 2560px screenshot.
				width={960}
				widths={[240, 480, 720, 960]}
			/>
		) : (
			<span
				aria-hidden="true"
				class:list={[
					"grid h-full place-items-center",
					styles["tile-card__initial"],
				]}
			>
				{item.title.charAt(0)}
			</span>
		)}
	</figure>
	<span
		class:list={[
			styles["tile-card__title"],
			item.isCode && styles["tile-card__title--code"],
		]}
	>
		{item.title}
	</span>
	{item.meta && <span class={styles["tile-card__meta"]}>{item.meta}</span>}
	{item.description && (
		<span class:list={["line-clamp-3", styles["tile-card__description"]]}>
			{item.description}
		</span>
	)}
	{hasChips && (
		<span class="flex flex-wrap gap-2">
			{item.status && (
				<Chip
					label={item.status.label}
					tone={item.status.tone}
				/>
			)}
			{item.chips?.map((chip) => (
				<Chip label={chip} />
			))}
		</span>
	)}
	{item.href && <span class="sr-only">(se abre en una pestaña nueva)</span>}
</Tag>
