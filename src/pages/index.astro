---
import Bio from "@components/Bio/index.astro";
import Contact from "@components/Contact/index.astro";
import Education from "@components/Education/index.astro";
import Footer from "@components/Footer/index.astro";
import Hero from "@components/Hero/index.astro";
import Navbar from "@components/Navbar/index.astro";
import SectionHeader from "@components/SectionHeader/index.astro";
import SystemBar from "@components/SystemBar/index.astro";
import TileList from "@components/TileList/index.astro";
import Layout from "@layouts/Layout/index.astro";

import { buildEducationSchema } from "@/data/educationSchema";
import {
	getCourses,
	getFreelanceTiles,
	getProjectTiles,
	getRepoTiles,
	getStudies,
	PROFILE,
} from "@/data/hub";
import { PERSON_ID, SITE_URL } from "@/data/personalSchema";
import { buildWorksSchema } from "@/data/worksSchema";

const [freelanceTiles, projectTiles, repoTiles] = await Promise.all([
	getFreelanceTiles(),
	getProjectTiles(),
	getRepoTiles(),
]);
const studies = getStudies();
const courses = getCourses();
const education = buildEducationSchema({ studies, courses: courses.recent });
const works = buildWorksSchema({
	personId: PERSON_ID,
	siteUrl: SITE_URL,
	tiles: projectTiles,
	freelance: freelanceTiles,
	repos: repoTiles,
});

// A section without content is left out of the page and the nav.
const sections = [
	{ id: "bio", label: "Bio", title: "Bio", isVisible: true },
	{
		id: "freelance",
		label: "Freelance",
		title: "Trabajo freelance",
		isVisible: freelanceTiles.length > 0,
	},
	{
		id: "proyectos",
		label: "Proyectos",
		title: "Side projects",
		isVisible: projectTiles.length > 0,
	},
	{
		id: "open-source",
		label: "Open source",
		title: "Open source",
		isVisible: repoTiles.length > 0,
	},
	{
		id: "formacion",
		label: "Formación",
		title: "Formación",
		isVisible: studies.length > 0 || courses.recent.length > 0,
	},
	{ id: "contacto", label: "Contacto", title: "Contacto", isVisible: true },
]
	.filter((section) => section.isVisible)
	.map((section, position) => ({
		...section,
		index: String(position + 1).padStart(2, "0"),
		isFirst: position === 0,
	}));

const section = Object.fromEntries(sections.map((item) => [item.id, item]));
---

<Layout
	education={education}
	works={works}
>
	<!-- One banner landmark: the system bar and the hero (axe "region"). -->
	<header>
		<SystemBar />
		<Hero />
	</header>
	<Navbar sections={sections} />
	<main
		class="mt-6 flex flex-col gap-8"
		id="main"
	>
		{section.bio && (
			<section
				aria-labelledby="bio"
				class="flex flex-col gap-4 px-4"
			>
				<SectionHeader {...section.bio} />
				<Bio />
			</section>
		)}
		{section.freelance && (
			<section
				aria-labelledby="freelance"
				class="flex flex-col gap-4 px-4"
			>
				<SectionHeader {...section.freelance} />
				<TileList items={freelanceTiles} />
			</section>
		)}
		{section.proyectos && (
			<section
				aria-labelledby="proyectos"
				class="flex flex-col gap-4 px-4"
			>
				<SectionHeader
					{...section.proyectos}
					action={{
						href: PROFILE.portfolioUrl,
						label: "Ver todos",
						srContext: "Proyectos: ",
					}}
				/>
				<TileList items={projectTiles} />
			</section>
		)}
		{section["open-source"] && (
			<section
				aria-labelledby="open-source"
				class="flex flex-col gap-4 px-4"
			>
				<SectionHeader {...section["open-source"]} />
				<TileList items={repoTiles} />
			</section>
		)}
		{section.formacion && (
			<section
				aria-labelledby="formacion"
				class="flex flex-col gap-4 px-4"
			>
				<SectionHeader {...section.formacion} />
				<Education
					courses={courses}
					studies={studies}
				/>
			</section>
		)}
		{section.contacto && (
			<section
				aria-labelledby="contacto"
				class="flex flex-col gap-4 px-4"
			>
				<SectionHeader {...section.contacto} />
				<Contact />
			</section>
		)}
	</main>
	<Footer />
</Layout>
