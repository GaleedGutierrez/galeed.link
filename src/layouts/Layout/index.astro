---
import "@fontsource/barlow/400.css";
import "@fontsource/barlow/500.css";
import "@fontsource/barlow/700.css";
import "@fontsource/barlow/800.css";
import "@fontsource-variable/jetbrains-mono";
import "@styles/index.css";

import barlow400 from "@fontsource/barlow/files/barlow-latin-400-normal.woff2?url";
import barlow700 from "@fontsource/barlow/files/barlow-latin-700-normal.woff2?url";
import barlow800 from "@fontsource/barlow/files/barlow-latin-800-normal.woff2?url";
import { Schema } from "astro-seo-schema";

import { personalSchema } from "@/data/personalSchema";

import styles from "./styles.module.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Galeed Gutierrez · Frontend developer",
	description = "Frontend developer en Jujuy, Argentina. Trabajo freelance, side projects, open source y contacto.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta
			content="width=device-width, initial-scale=1"
			name="viewport"
		/>
		<!-- Follow the OS text size. Requires never setting font-size on html. -->
		<meta
			content="scale"
			name="text-scale"
		/>
		<meta
			content="light dark"
			name="color-scheme"
		/>
		<meta
			content="#ede6d8"
			media="(prefers-color-scheme: light)"
			name="theme-color"
		/>
		<meta
			content="#141414"
			media="(prefers-color-scheme: dark)"
			name="theme-color"
		/>
		<!-- Resolve the theme before first paint (DESIGN_SYSTEM.md §2.2). -->
		<script is:inline>
			(() => {
				const KEY = "galeed:theme";
				const root = document.documentElement;
				let pref = "system";
				try {
					const stored = localStorage.getItem(KEY);
					if (stored === "light" || stored === "dark") pref = stored;
				} catch {
					/* storage blocked: stay on system */
				}
				const resolved =
					pref === "system"
						? window.matchMedia("(prefers-color-scheme: dark)")
								.matches
							? "dark"
							: "light"
						: pref;
				// setAttribute (not dataset): PurgeCSS must see "data-theme".
				root.setAttribute("data-theme", resolved);
				root.setAttribute("data-theme-pref", pref);
				root.style.colorScheme = resolved;
			})();
		</script>
		<link
			as="font"
			crossorigin
			href={barlow400}
			rel="preload"
			type="font/woff2"
		/>
		<!-- 700: social labels, nav and column headings, all above the fold. -->
		<link
			as="font"
			crossorigin
			href={barlow700}
			rel="preload"
			type="font/woff2"
		/>
		<link
			as="font"
			crossorigin
			href={barlow800}
			rel="preload"
			type="font/woff2"
		/>
		<link
			href="/favicon.svg"
			rel="icon"
			type="image/svg+xml"
		/>
		<link
			href="/sitemap-index.xml"
			rel="sitemap"
		/>
		<meta
			content={description}
			name="description"
		/>
		<Schema
			item={{
				"@context": "https://schema.org",
				"@type": "Person",
				name: personalSchema.name,
				alternateName: personalSchema.alternateName,
				url: "https://galeed.link",
				image: "https://galeed.link/profile.webp",
				jobTitle: "Frontend Developer",
				description:
					"Desarrollador frontend con experiencia en React, Astro y pruebas E2E. Apasionado por crear interfaces limpias, funcionales y accesibles.",
				sameAs: [
					personalSchema.socialLinks.github,
					personalSchema.socialLinks.linkedin,
					personalSchema.socialLinks.x,
					personalSchema.socialLinks.personalWebsite,
					personalSchema.socialLinks.portfolio,
				],
				knowsAbout: personalSchema.skills,
				alumniOf: personalSchema.education,
				hasOccupation: personalSchema.jobProfile,
				hasPart: personalSchema.relatedProjects,
			}}
		/>
		<title>{title}</title>
	</head>
	<body>
		<a
			class="skip-link a-button a-button--primary"
			href="#main"
			>Saltar al contenido</a
		>
		<div
			class={styles.shell}
			id="top"
		>
			<slot />
		</div>
		<script
			defer
			is:inline
			src={"https://www.googletagmanager.com/gtag/js?id=G-XEPRCKCX47"}
			type="text/partytown"
		></script>
		<script defer is:inline type="text/partytown">
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());

			gtag("config", "G-XEPRCKCX47");
		</script>
		<script defer is:inline type="text/partytown">
			function sendToGoogleAnalytics({ name, delta, id }) {
				gtag("event", name, {
					event_category: "Web Vitals",
					event_label: id,
					value: Math.round(name === "CLS" ? delta * 1000 : delta),
					non_interaction: true,
				});
			}

			(function () {
				var script = document.createElement("script");
				script.src =
					"https://unpkg.com/web-vitals@5/dist/web-vitals.iife.js";
				script.onload = function () {
					webVitals.onCLS(sendToGoogleAnalytics);
					webVitals.onINP(sendToGoogleAnalytics);
					webVitals.onLCP(sendToGoogleAnalytics);
				};
				document.head.appendChild(script);
			})();
		</script>
	</body>
</html>
