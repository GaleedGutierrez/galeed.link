{
	"$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/v0.24.2/schema/markdownlint-cli2-config-schema.json",
	// The globs live here, not in the npm scripts: npm runs scripts with sh on
	// CI, which reads an unquoted ** as * and would lint one folder level only.
	"globs": ["**/*.md"],
	// Skips dist/, node_modules/, .playwright-mcp/ and the rest git ignores.
	"gitignore": true,
	"ignores": [".agents/**", ".claude/**"],
	"config": {
		"MD003": {
			"style": "atx"
		},
		"MD004": {
			"style": "dash"
		},
		// Prettier wraps prose at 80 columns (.prettierrc). The default mode
		// still allows a line whose overflow has no spaces, like a long URL
		// Prettier can't break.
		"MD013": {
			"headings": false,
			"code_blocks": false
		},
		"MD024": {
			"siblings_only": true
		},
		"MD029": {
			"style": "ordered"
		},
		"MD035": {
			"style": "---"
		},
		"MD046": {
			"style": "fenced"
		},
		"MD048": {
			"style": "backtick"
		},
		// The emphasis and strong markers Prettier writes.
		"MD049": {
			"style": "underscore"
		},
		"MD050": {
			"style": "asterisk"
		}
	}
}
