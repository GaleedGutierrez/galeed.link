#!/usr/bin/env sh
# 1. Every commit this push sends must be a Conventional Commit: commit-msg
#    misses the ones a rebase or an amend rewrote.
# 2. Every linter, the type check and the Vitest suite (npm run verify).
zero=0000000000000000000000000000000000000000

while read -r local_ref local_sha _ remote_sha; do
	# Deleting a remote branch sends no commits.
	[ "$local_sha" = "$zero" ] && continue

	# A new branch, or a remote tip this clone doesn't have: lint what isn't on
	# main yet.
	if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha" 2>/dev/null; then
		from=$(git merge-base origin/main "$local_sha")
	else
		from=$remote_sha
	fi

	echo "commitlint: $local_ref ($from..$local_sha)"
	npx --no -- commitlint --from "$from" --to "$local_sha"
done

npm run verify
