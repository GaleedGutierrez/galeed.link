{
	"plugins": ["stylelint-order"],
	"extends": ["stylelint-config-standard"],
	"reportDescriptionlessDisables": true,
	"reportInvalidScopeDisables": true,
	"reportNeedlessDisables": true,
	"rules": {
		"declaration-no-important": true,
		"at-rule-no-unknown": [
			true,
			{ "ignoreAtRules": ["define-mixin", "mixin"] }
		],
		"selector-class-pattern": [
			"^[a-z][a-z0-9]*(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?$",
			{
				"message": "Expected class selector \"%s\" to be lowercase BEM (block__element--modifier)"
			}
		],
		"color-no-hex": true,
		"color-named": "never",
		"font-weight-notation": "named-where-possible",
		"import-notation": "string",
		"function-disallowed-list": [
			"rgba",
			"hsla",
			"rgb",
			"hsl",
			"lab",
			"hwb"
		],
		"hue-degree-notation": "number",
		"media-feature-name-value-allowed-list": {
			"width": ["40em", "48em", "64em", "90em"]
		},
		"declaration-property-value-disallowed-list": {
			"/^outline(-style)?$/": ["none", "/^0(px)?$/"]
		},
		"property-disallowed-list": [
			[
				"width",
				"height",
				"min-width",
				"max-width",
				"min-height",
				"max-height",
				"top",
				"right",
				"bottom",
				"left",
				"/^margin-(top|right|bottom|left)$/",
				"/^padding-(top|right|bottom|left)$/",
				"/^border-(top|right|bottom|left)(-(width|style|color))?$/",
				"/^border-(top|bottom)-(left|right)-radius$/",
				"/^scroll-(margin|padding)-(top|right|bottom|left)$/"
			],
			{
				"message": "Use the logical property instead of \"%s\" (inline-size, margin-block-start…)"
			}
		],
		"order/order": [
			"custom-properties",
			"declarations",
			"rules",
			"at-rules"
		],
		"declaration-block-no-redundant-longhand-properties": [
			true,
			{ "ignoreShorthands": ["/grid/"] }
		],
		"order/properties-order": [
			[
				"position",

				"inset",
				"inset-block",
				"inset-inline",

				"inset-block-start",
				"inset-inline-end",
				"inset-block-end",
				"inset-inline-start",

				"z-index",

				"display",

				"grid",
				"grid-template",
				"grid-template-rows",
				"grid-template-columns",
				"grid-template-areas",
				"grid-auto-rows",
				"grid-auto-columns",
				"grid-auto-flow",
				"grid-area",
				"grid-row",
				"grid-column",
				"grid-row-start",
				"grid-row-end",
				"grid-column-start",
				"grid-column-end",

				"flex-flow",
				"flex-direction",
				"flex-wrap",
				"flex",
				"flex-grow",
